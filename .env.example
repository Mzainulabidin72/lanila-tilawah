# Dapatkan dari Supabase Dashboard > Project Settings > API
# Gunakan HANYA anon (public) key. JANGAN PERNAH memakai service_role key di frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (Opsional, HANYA saat pengembangan) Tampilkan pembaca dengan konten placeholder yang BUKAN Al-Qur'an,
# untuk menguji tampilan sebelum dataset tervalidasi diimpor. Selalu nonaktif pada build produksi.
# VITE_QURAN_PLACEHOLDER=true
