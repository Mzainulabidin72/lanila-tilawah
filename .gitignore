node_modules
dist
.env
.env.*
!.env.example
*.local
.vercel
.DS_Store

# Part 03: berkas sumber Al-Qur'an & hasil build (unduh manual; jangan commit terjemahan berlisensi non-komersial)
data/quran-source/*
!data/quran-source/README.md
data/quran-build
!data/quran-source/SOURCES.json
!data/quran-source/original/
!data/quran-source/processed/
# isi folder tetap diabaikan (berkas asli/terjemahan berlisensi tidak di-commit); hanya penanda & manifes checksum
data/quran-source/original/*
!data/quran-source/original/.gitkeep
!data/quran-source/original/MANIFEST.json
data/quran-source/processed/*
!data/quran-source/processed/.gitkeep
